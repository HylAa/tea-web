# TeaHvh-Web 生产环境配置模板
# 复制此文件为 .env.production 并填入实际配置信息

# ========================================
# 基础配置
# ========================================

# 应用环境
NODE_ENV=production

# API 基础 URL (开发环境：直接访问后端，生产环境：通过nginx代理)
VITE_API_BASE_URL=https://api.teahvh.cc/api

# 站点基础信息
VITE_APP_TITLE=茶游戏社区
VITE_APP_DESCRIPTION=专业的游戏社区平台
VITE_SITE_URL=https://www.teahvh.cc

# ========================================
# Steam 登录配置 (必填)
# ========================================

# Steam OpenID 回调配置 (重要: 必须是 HTTPS 域名)
VITE_STEAM_REALM=https://www.teahvh.cc
VITE_STEAM_RETURN_URL=https://www.teahvh.cc/steam-callback

# Steam Web API 密钥 (用于获取详细的用户信息)
# 从 https://steamcommunity.com/dev/apikey 获取
# 开发环境使用个人API密钥，生产环境需要使用公司账户
VITE_STEAM_API_KEY=CA717185F1A90DC7E1E2CC725EA63FFB

# Steam 应用信息 (可选 - 仅用于显示)
VITE_STEAM_APP_NAME=TeaHvh Gaming Community

# ========================================
# 安全配置
# ========================================

# 会话加密密钥 (建议使用随机字符串)
VITE_SESSION_KEY=your-session-encryption-key-here

# 设备指纹密钥
VITE_FINGERPRINT_KEY=your-fingerprint-key-here

# 会话过期时间 (小时)
VITE_SESSION_EXPIRE_HOURS=168

# ========================================
# 部署配置
# ========================================

# 构建输出目录
VITE_BUILD_OUTPUT=dist

# 静态资源CDN (可选)
VITE_CDN_URL=

# 是否启用PWA (可选)
VITE_PWA_ENABLED=false

# ========================================
# 监控与分析 (可选)
# ========================================

# Google Analytics 4 (可选)
VITE_GA_MEASUREMENT_ID=

# 错误监控服务 (如Sentry，可选)
VITE_SENTRY_DSN=

# ========================================
# 功能开关 (可选)
# ========================================

# 是否启用开发者工具
VITE_DEVTOOLS_ENABLED=false

# 是否启用调试模式
VITE_DEBUG_MODE=false

# 是否启用性能监控
VITE_PERFORMANCE_MONITORING=true

# ========================================
# Steam 配置 (临时)
# ========================================

# 是否跳过Steam签名验证 (临时方案，等待后端API支持)
VITE_SKIP_STEAM_VERIFY=true